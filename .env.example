# JARVIS Environment Configuration
# Copy this file to .env and fill in your values

# ── AI Model ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
AI_MODEL=gpt-4o
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# ── Voice ─────────────────────────────────────────────────────────
VOICE_ENABLED=true
VOICE_TTS_ENGINE=edge
VOICE_STT_ENGINE=whisper
VOICE_WAKE_WORD=hey jarvis

# ── Memory ────────────────────────────────────────────────────────
MEMORY_ENABLED=true
MEMORY_DATA_DIR=./data/memory
MEMORY_MAX_ENTRIES=10000

# ── Security ──────────────────────────────────────────────────────
SECURITY_ENABLED=true
JWT_SECRET=change-this-to-a-random-secret
ENCRYPTION_KEY=change-this-to-a-random-key

# ── API Server ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ── Backup ────────────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=./data/backups

# ── Weather (optional) ───────────────────────────────────────────
OPENWEATHERMAP_API_KEY=

# ── News (optional) ──────────────────────────────────────────────
NEWSAPI_KEY=
